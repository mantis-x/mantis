# ── Chain selection ──────────────────────────────────────────────────────────
# Comma-separated list of chains to monitor. Phase 0: mantle only.
# Phase 1 (Arbitrum): set CHAINS=mantle,arbitrum
# Phase 3 (HashKey Chain): set CHAINS=mantle,arbitrum,hashkey
# Phase 4 (Ethereum): set CHAINS=mantle,arbitrum,hashkey,ethereum
CHAINS=mantle

# ── Mantle ──────────────────────────────────────────────────────────────────
MANTLE_RPC_URL=https://rpc.mantle.xyz
MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz
DEPLOYER_PRIVATE_KEY=0x...

# ── Arbitrum (Phase 1) ───────────────────────────────────────────────────────
# Recommend a keyed provider (Alchemy/Infura) — public arb1.arbitrum.io/rpc
# rate-limits get_logs at high batch sizes.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ── Arbitrum execution (Phase 2) ─────────────────────────────────────────────
# Defaults below are Arbitrum One mainnet. Override for Arbitrum Sepolia:
#   ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
#   ARB_SWAP_ROUTER=0x101F443B4d1b059569D643917553c771E1b9663E
#   ARB_WETH_ADDRESS=0x980B62Da83eFf3D4576C647993b0c1D7faf17c73
#   ARB_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
#   ARB_QUOTER_V2=0x2779a0CC1c3e0E44D2542EC3e79e3864Ae93Ef0B
#   ARB_ETH_USD_FEED=0xd30e2101a97dcbAeBCBC04F14C3f624E67A35165
ARB_SWAP_ROUTER=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
ARB_WETH_ADDRESS=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
ARB_USDC_ADDRESS=0xFF970A61A04b1cA14834A43f5dE4533eBDDB5CC8
ARB_QUOTER_V2=0x61fFE014bA17989E743c5F6cB21bF9697530B21e
ARB_ETH_USD_FEED=0x639Fe6ab55C921f74e7fac1ee960C0B6293ba612
BYREAL_DRY_RUN=true   # set to false only after Sepolia validation and explicit go-ahead

# ── HashKey Chain (Phase 3) ──────────────────────────────────────────────────
# chain_id 177 (mainnet) / 133 (testnet), OP-stack, ~2s blocks. Signal source
# is token transfer-flow monitoring (USDT/WETH/WHSK), not DEX swaps — no DEX
# with meaningful volume was found on HashKey Chain at launch.
# Contract deploy plan: testnet first (free faucet, hsk.xyz/faucet) to
# validate end-to-end, then mainnet once deployer wallet is funded.
HASHKEY_RPC_URL=https://mainnet.hsk.xyz
HASHKEY_TESTNET_RPC_URL=https://testnet.hsk.xyz

# ── Ethereum (Phase 4) ───────────────────────────────────────────────────────
# chain_id 1. Ingestion tracks real Uniswap V3 volume on mainnet (blue-chip
# pools only — see chains.py's ETHEREUM entry for how they were verified).
# SignalAuditLog/AgentIdentity deploy straight to mainnet too (2026-07-18) —
# no Sepolia staging step, since no Sepolia ETH was available for the
# deployer wallet. ETHEREUM_RPC_URL drives both ingestion and on-chain audit
# logging, same as every other chain. Public RPCs here are noticeably
# stricter on eth_getLogs range than Mantle/Arbitrum's — a paid RPC key will
# likely be needed sooner than it was for Arbitrum.
ETHEREUM_RPC_URL=https://ethereum.publicnode.com

# ── External APIs ────────────────────────────────────────────────────────────
# Wallet smart-money labeling for the enrichment worker. The default path
# (packages/enrichment/src/wallet_track_record.py) needs NO key — it labels a
# wallet from Mantis's own signal-outcome track record, read straight from
# REDIS_URL below. Tune with WALLET_TRACK_RECORD_MIN_SAMPLES (default 3) and
# WALLET_TRACK_RECORD_HIT_RATE (default 0.65).
# NANSEN_API_KEY is an optional fallback (packages/enrichment/src/nansen.py),
# only consulted for a wallet with too few resolved samples in our own
# track record yet. Leave unset if you don't want the Nansen dependency at all.
# VERIFY BEFORE SETTING IN PROD: the request/response schema was written from
# Nansen's docs, never exercised against a real key. Run one real lookup against
# a wallet you know is labeled smart_money and confirm it actually returns True
# before relying on this live — see the docstring in nansen.py for why a wrong
# schema fails silently instead of loudly.
NANSEN_API_KEY=
ELFA_API_KEY=
ANTHROPIC_API_KEY=

# ── Enrichment alerting ──────────────────────────────────────────────────────
# Closes the silent-failure pattern that hid three real bugs (retired model,
# exhausted billing, ThinkingBlock crash) for weeks each, since _call_claude()
# only ever logged errors and returned None. The Redis-counter half of this
# (mantis:stats:enrichment_errors_*, surfaced in /status) always runs — these
# two vars only control the OPTIONAL push alert on top of that.
ADMIN_TELEGRAM_CHAT_ID=              # your own chat_id with the bot — leave blank to skip push alerts, degraded state is still visible via /status
ENRICHMENT_ALERT_THRESHOLD=5         # consecutive Claude-call failures before alerting
ENRICHMENT_ALERT_COOLDOWN_MINUTES=30 # minimum gap between repeat alerts for the same ongoing incident

# ── Telegram (Track 2) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=   # optional: set for webhook mode, leave blank for polling

# ── Discord (Track 2) ────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=      # optional: leave blank to disable the Discord bot

# ── LINE (Track 2) ───────────────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=   # optional: leave blank to disable the LINE bot
LINE_CHANNEL_SECRET=         # optional: leave blank to disable the LINE bot
LINE_PORT=8000               # port the LINE webhook server listens on

# ── Byreal (Track 6) ────────────────────────────────────────────────────────
BYREAL_AGENT_WALLET=0x...
BYREAL_PRIVATE_KEY=0x...

# ── Contracts ────────────────────────────────────────────────────────────────
# Audit/identity loggers now route per origin chain (mantle/arbitrum/hashkey/
# ethereum). These are the fallback addresses used when no chain-specific
# override is set below — currently correct for Mantle/HashKey because the
# deployer wallet used the same nonce sequence on both, making the CREATE
# address identical. Arbitrum and Ethereum both needed overrides (nonce
# collisions from unrelated prior activity on those chains before this
# project's first deploy there — see Contracts section of README.md).
AUDIT_CONTRACT_ADDRESS=0xd745Fc0c28B8755b6280232a179e21C50B1D3adf
AGENT_IDENTITY_CONTRACT_ADDRESS=0x06036B53A1f8d2Cf691a6f324C0672eB6D865667
# ARBITRUM_AUDIT_CONTRACT_ADDRESS=
# ARBITRUM_AGENT_IDENTITY_CONTRACT_ADDRESS=
# HASHKEY_AUDIT_CONTRACT_ADDRESS=
# HASHKEY_AGENT_IDENTITY_CONTRACT_ADDRESS=
ETHEREUM_AUDIT_CONTRACT_ADDRESS=0x3efa7b94cbB56c9046ffB10a999dB5ba8220DD85
ETHEREUM_AGENT_IDENTITY_CONTRACT_ADDRESS=0x311E456e0A0786b36B6152fbc83cb4078bc0AE13

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mantis:password@localhost:5432/mantis
POSTGRES_USER=mantis
POSTGRES_PASSWORD=password
POSTGRES_DB=mantis

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Detection tuning ────────────────────────────────────────────────────────
ZSCORE_THRESHOLD=2.5            # global threshold — flag events above this z-score
ZSCORE_THRESHOLD_ARBITRUM=3.5   # per-chain override: Arbitrum volume is noisier
# ZSCORE_THRESHOLD_ETHEREUM=3.5  # uncomment if Ethereum's blue-chip pools prove as noisy as Arbitrum's
CLUSTER_WINDOW_MINUTES=30       # time window for wallet co-movement grouping
SOLO_SIGNAL_COOLDOWN_MINUTES=30 # suppress a repeat solo candidate from the same (wallet, pool, event_type) within this window — fixes near-duplicate alerts from the same wallet as the baseline recalculates
MIN_CONFIDENCE_SCORE=50         # discard LLM signals below this
SIGNAL_HOLD_MINUTES=5           # anti-front-running delay before dispatch

# Multi-wallet clustering (packages/detection/src/detector.py). MULTIWALLET_MIN_USD
# and MULTIWALLET_EXCLUDE_TYPES already existed (Railway-only, not previously
# documented here); the two below were added 2026-07-23 after the UNIV3_SWAP_TOPIC
# fix let real Uniswap V3 swaps flow on Arbitrum/Ethereum for the first time and
# exposed a liquid pool's ordinary dozens-of-wallets-per-30-min turnover as
# false "coordination" — see PROJECT_STATE.md for the incident writeup.
MULTIWALLET_MIN_USD=100000          # floor on a multi-wallet cluster's aggregate USD
# MULTIWALLET_EXCLUDE_TYPES=transfer  # event types never eligible for multi-wallet clustering
MULTIWALLET_MAX_WALLETS=15          # beyond this many distinct wallets in the window, treat as ordinary liquidity, not coordination
MULTIWALLET_COOLDOWN_MINUTES=30     # at most one multi-wallet emission per (pool, event_type) per this many minutes, regardless of new wallets joining

# ── Guard defaults (AlphaExecutor) ──────────────────────────────────────────
DEFAULT_MAX_POSITION_PCT=5      # max % of wallet balance per execution
DEFAULT_MAX_SLIPPAGE_PCT=2      # abort if slippage exceeds this (real quote-vs-execution
                                 # slippage protection lives in arbitrum/swap_executor.py's
                                 # QuoterV2 call; this guard is a pre-flight sanity bound)
MAX_TRADE_USD=50                # hard per-trade USD ceiling, independent of wallet size —
                                 # docs/execute_readiness.md's own recommended starting range
MAX_DAILY_TRADE_USD=200         # hard cumulative-per-UTC-day USD ceiling across all trades
SIGNAL_DEDUP_TTL_SECONDS=86400  # how long a signal's execution-dedup lock lives (packages/executor/src/safety.py)

# Kill switch: `python scripts/execution_kill_switch.py on|off|status` — sets/clears
# the mantis:execution:kill_switch Redis key the executor worker checks every loop
# iteration. Halts execution with no redeploy; queued signals are NOT dropped.

# ── Environment ──────────────────────────────────────────────────────────────
ENV=development                 # development | staging | production
LOG_LEVEL=INFO
